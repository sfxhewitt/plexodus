<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Catches taps over the video; the controls sit above it. -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- "Dolby Atmos · Passthrough" for a few seconds at the start, so you know it's working. -->
    <TextView
        android:id="@+id/audioBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:alpha="0"
        android:background="@drawable/bg_track_panel"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/red" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                android:tint="@color/control_fg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <!-- Shown while paused: what this is about. -->
                <TextView
                    android:id="@+id/overview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="3"
                    android:maxWidth="560dp"
                    android:textColor="@color/text"
                    android:alpha="0.85"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/rewind"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/rewind"
                android:src="@drawable/ic_rewind"
                android:tint="@color/control_fg" />

            <ImageButton
                android:id="@+id/play_pause"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/play_pause"
                android:scaleType="fitCenter"
                android:padding="22dp"
                android:src="@drawable/ic_play"
                android:tint="@color/control_fg" />

            <ImageButton
                android:id="@+id/forward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward"
                android:tint="@color/control_fg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="40dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="@color/red"
                    android:progressBackgroundTint="@color/glass"
                    android:thumbTint="@color/text" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ends_at"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Button
                    style="@style/PlayerPill"
                    android:id="@+id/audio"
                    android:layout_width="wrap_content"
                    android:drawableStart="@drawable/ic_audio"
                    android:text="@string/audio"
                    android:visibility="gone" />

                <Button
                    style="@style/PlayerPill"
                    android:id="@+id/subtitles"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:drawableStart="@drawable/ic_subtitles"
                    android:text="@string/subtitles"
                    android:visibility="gone" />

                <Button
                    style="@style/PlayerPill"
                    android:id="@+id/sync"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/audio_sync" />

                <ImageButton
                    android:id="@+id/stats_button"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_button"
                    android:contentDescription="@string/stats"
                    android:src="@drawable/ic_info"
                    android:tint="@color/control_fg" />

                <ImageButton
                    android:id="@+id/aspect"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_button"
                    android:contentDescription="@string/aspect"
                    android:src="@drawable/ic_aspect"
                    android:tint="@color/control_fg" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_stats"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="@color/text"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Audio sync bar: small and see-through so the lips stay visible. -->
    <TextView
        android:id="@+id/sync_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_sync_bar"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:shadowColor="#000000"
        android:shadowRadius="4"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Lip sync calibration: instructions and the current device offset. -->
    <TextView
        android:id="@+id/calibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_stats"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_pill_button"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null"
        android:text="@string/skip_intro"
        android:textSize="14sp"
        android:minHeight="0dp"
        android:textAllCaps="false"
        android:textColor="@color/control_fg"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- "Up next" at the credits, and the "still watching?" check. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_stats"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/up_next_art"
            android:layout_width="208dp"
            android:layout_height="117dp"
            android:background="@color/surface">

            <ImageView
                android:id="@+id/up_next_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/up_next_count"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_round_button"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/up_next_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/red"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/up_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/up_next_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/up_next_play"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_play"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/primary_fg"
                    android:minWidth="0dp"
                    android:nextFocusRight="@+id/up_next_cancel"
                    android:paddingStart="12dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/play_now"
                    android:textSize="13sp"
                    android:minHeight="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_fg"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/up_next_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_button"
                    android:minWidth="0dp"
                    android:nextFocusLeft="@id/up_next_play"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/cancel"
                    android:textSize="13sp"
                    android:minHeight="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/control_fg" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

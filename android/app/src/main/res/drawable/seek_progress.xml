<?xml version="1.0" encoding="utf-8"?>
<!-- Slim progress line: faint track, red-to-rose fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="4dp" />
            <solid android:color="#33FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="4dp" />
                <solid android:color="#4DFFFFFF" />
                <corners android:radius="2dp" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="4dp" />
                <gradient android:angle="0" android:startColor="#B3172F" android:endColor="#FF4762" />
                <corners android:radius="2dp" />
            </shape>
        </scale>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Only the GitHub APK updates itself (see Updater.kt). Store builds are
     updated by Google Play or the Amazon Appstore and must not ask to
     install packages. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>

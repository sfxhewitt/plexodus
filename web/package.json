{
  "name": "plexodus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tv": "vite --host --mode tv",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p e2e",
    "test:tv": "playwright test",
    "test:tv:ui": "playwright test --ui",
    "test:tv:screens": "playwright test --grep-invert \"focus audit\""
  },
  "dependencies": {
    "hls.js": "^1.6.2",
    "jassub": "2.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
